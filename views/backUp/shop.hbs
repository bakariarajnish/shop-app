<main>
  <h2>My Products</h2>
  {{#if hasProducts}}
    <div class="grid">
      {{#each products}}
        <article class="card product-item">
          <header class="card__header">
            <h1 class="product__title">{{this.productName}}</h1>
          </header>

          <div class="card__image">
            <img
              src="https://plus.unsplash.com/premium_photo-1669652639337-c513cc42ead6?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
              alt="my image"
              width="200"
              height="200"
            />
          </div>
          <div class="card__content">
            <h2 class="product__price">$19.99</h2>
            <p class="product__description">A very interesting book</p>
          </div>

          <div class="card__actions">
            <button>Add to Cart</button>
          </div>

        </article>

      {{/each}}
    </div>
  {{else}}
    No Product available
  {{/if}}
</main>