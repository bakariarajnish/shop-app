extends ./layouts/main-layout.pug
block otherHeader
    link(rel="stylesheet", href="/css/shop.css")
block mainContent
        main
            if products.length > 0
                .grid
                    each product in products
                        article.card.product-item
                            header.card__header
                                h1.product__title #{product.productName}
                            div.card__image
                                img(src="https://plus.unsplash.com/premium_photo-1669652639337-c513cc42ead6?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D", alt="my image", width="200", height="200") 
                            div.card__content
                                h2.product__price $19.99
                                p.product__description A very interesting book
                            div.card__actions 
                                button.btn Add to Cart 
            else 
                h2 No product available.