<%- include('../includes/head.ejs')%>
    <link href="/css/product.css" rel="stylesheet" />
  </head>

  <body>
    <%- include('../includes/navigation.ejs')%>
    <main>
      <form class="product-form" action="/admin/<% if(editing) {%>edit-product<%} else {%>add-product<% }%>" method="post">
        <div class="form-control">
          <label for="pName">Product Name</label>
          <input type="text" name="productName" id="pName" value="<% if(editing) {%><%=product.productName%><%}%>" />
        </div>
        <div class="form-control">
          <label for="imageUrl">Product Image</label>
          <input type="text" name="imageUrl" id="imageUrl" value="<%if(editing) {%><%=product.imageUrl%><%}%>" />
        </div>
        <div class="form-control">
          <label for="price">Product Price</label>
          <input type="text" name="price" id="price" value="<% if(editing) {%><%=product.price%><%}%>" />
        </div>
        <div class="form-control">
          <label for="description">Product Description</label>
          <textarea name="description" id="description" rows="5"><% if(editing) {%><%=product.description%><%}%>
          </textarea>
        </div>
        <% if(editing) { %>
          <input type="hidden" name="productId" value="<%=product.id%>" />
        <% } %>
        <button type="submit">
          <% if(editing) {%>
            Update Product
            <%} else { %>
              Add Product
          <% } %>
        </button>
      </form>
    </main>
  <%- include('../includes/footer.ejs')%>